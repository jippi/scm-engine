{
  extends: [
    "config:recommended",
    ":pinDevDependencies",
    ":separateMultipleMajorReleases",
    // Keep '.github/workflows' on 'uses: owner/repo@<sha> # vX.Y.Z' and let
    // Renovate maintain both the digest and the version comment. Digest
    // pinning stays off everywhere else (Renovate's default).
    "helpers:pinGitHubActionDigests",
  ],
  schedule: [
    "* */1 * * *", // every 1 hour
  ],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  commitMessageSuffix: " in {{packageFile}}",
  dependencyDashboardAutoclose: false,
  automerge: true,
  baseBranchPatterns: ["main"],
  platformAutomerge: true,
  labels: ["dependencies"],
  prHourlyLimit: 1,
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["security"],
  },
  packageRules: [
    {
      matchPackageNames: ["go", "golang"],
      groupName: "go",
    },
    {
      matchDatasources: ["golang-version"],
      rangeStrategy: "bump",
      groupName: "go",
    },
    {
      description: [
        "Don't raise PRs for indirect go.mod deps - they get bumped by 'go mod tidy'",
        "whenever a direct dep needs it. Security updates still come through, because",
        "the 'vulnerabilityAlerts' config is applied last and re-enables them.",
      ],
      matchManagers: ["gomod"],
      matchDepTypes: ["indirect"],
      enabled: false,
    },
    {
      matchDepTypes: ["golang-version"],
      prPriority: 999,
    },
    {
      description: [
        "Group charmbracelet packages. They also publish under the 'charm.land'",
        "vanity path (lipgloss v2 lives at 'charm.land/lipgloss/v2'), so match both.",
      ],
      groupName: "charmbracelet",
      matchPackageNames: [
        "github.com/charmbracelet/{/,}**",
        "charm.land/{/,}**",
      ],
    },
    {
      description: "Group golang.org/x/ packages",
      matchPackageNames: ["golang.org/x/{/,}**"],
      groupName: "x",
    },
    {
      description: [
        "Major upgrades need a human. A green pipeline only proves the code still",
        "compiles and the tests still pass, which is not the same as the behaviour",
        "being unchanged - a major can keep compiling while quietly changing what a",
        "function returns. Minor, patch and digest updates keep automerging.",
        "Listed last so it wins over the rules above.",
      ],
      matchUpdateTypes: ["major"],
      automerge: false,
    },
  ],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)Dockerfile$/", "/(^|/)Dockerfile\\.[^/]*$/"],
      matchStrings: [
        // example:
        //
        // # renovate: datasource=github-releases depName=hashicorp/terraform versioning=hashicorp
        // ENV DEFAULT_TERRAFORM_VERSION=x.x.x
        //
        // # renovate: datasource=github-releases depName=open-policy-agent/conftest
        // ARG DEFAULT_CONFTEST_VERSION=x.x.x
        "renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s(ARG|ENV) .*?_VERSION=(?<currentValue>.*)\\s",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*?: (?<currentValue>.*)\\s",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],
}
